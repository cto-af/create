  "decription": "Create a @cto.af-style project",
  "bin": "index.js",
  "type": "module",
  "keywords": [
    "scaffold,",
    "template,",
    "generate,",
    "project"
  ],
  "author": "Joe Hildebrand <joe-github@cursive.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
