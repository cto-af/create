    "build": "npm run lint && npm run test"
  },
  "dependencies": {
    "execa": "9.6.0",
    "glob": "11.0.3",
    "simple-scaffold": "2.3.3"
  },
  "devDependencies": {
    "@cto.af/eslint-config": "6.1.0",
    "eslint": "9.39.1",
    "npm-check-updates": "19.1.2",
    "rimraf": "6.1.0",
    "typescript-eslint": "8.46.4"
  },
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=20"
  }
}
