    "eslint-plugin-jsdoc": "62.7.1",
    "npm-check-updates": "19.6.3",
    "rimraf": "6.1.3",
    "tsdown": "0.21.0-beta.2",
    "typescript-eslint": "8.56.1",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
